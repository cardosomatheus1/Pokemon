{
  "name": "pokearena",
  "version": "1.0.0-V1.15",
  "private": true,
  "type": "module",
  "description": "PokéArena — battle royale de apostas com moeda simulada",
  "scripts": {
    "snapshot": "node tools/snapshot-prototipo.mjs",
    "assets": "node tools/baixar-assets.mjs",
    "test": "node test/run.mjs",
    "test:sem-golden": "SEM_GOLDEN=1 node test/run.mjs",
    "test:gerar": "node test/run.mjs --gerar",
    "sabotagem": "node test/sabotagem.mjs",
    "sabotagem:tocados": "node test/sabotagem.mjs --tocados",
    "portoes": "npm run repetir && npm run sabotagem",
    "repetir": "node tools/repetir-portao.mjs",
    "serve": "node prototype/serve.js"
  }
}
